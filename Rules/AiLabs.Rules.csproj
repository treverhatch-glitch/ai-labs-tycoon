<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The game rules: plain C#, no engine types. netstandard2.1 is the API surface Unity 6 offers,
    and LangVersion 9 is Unity 6's C#, so anything Unity could not compile fails here first.
    Unity compiles these same sources through AiLabs.Rules.asmdef (noEngineReferences: true).
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>AiLabs.Rules</AssemblyName>
    <RootNamespace>AiLabs.Rules</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
